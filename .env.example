# TRACE environment — copy values into backend/.env and frontend/.env
# Never commit real secrets.

DATABASE_URL=mongodb://localhost:27017
MONGODB_DB=trace
# For Atlas, set DATABASE_URL to your full mongodb+srv:// URI and replace all placeholders.
# Use a MongoDB database user (not your Atlas website login) and URL-encode special password characters.
# If your network's DNS resolver refuses Atlas SRV lookups, the backend retries with these servers.
MONGODB_DNS_FALLBACK_SERVERS=1.1.1.1,8.8.8.8

API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Ed25519 PEM. Leave empty to auto-generate a demo keypair at startup.
SIGNING_PRIVATE_KEY=
SIGNING_PUBLIC_KEY=

CORS_ORIGIN=http://localhost:5173
PORT=8000
DEMO_MODE=true

SUPABASE_URL=
SUPABASE_ANON_KEY=
